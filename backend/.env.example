# Copy this file to .env and fill in real values for local development.
# In Render, set these as environment variables in the service dashboard instead —
# never commit a real .env file (it's already gitignored).

# Supabase Dashboard -> Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Settings -> API -> service_role secret key
# Full-access key — server-side only, NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The deployed frontend origin allowed to call this API (CORS). For local dev
# this is the Vite dev server; in Render, set it to your Vercel URL.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Render injects PORT automatically in production — this is only used locally.
PORT=4000

# Resend (https://resend.com) -> API Keys -> Create API Key — sends the 6-digit registration
# verification code. Backend-only; never exposed to the frontend/Vite build, never named
# VITE_RESEND_API_KEY. Never commit a real value for this key.
#
# IMPORTANT — Resend sandbox restriction: until a domain is verified at resend.com/domains,
# a Resend account can ONLY deliver to the email address that owns the Resend account itself.
# Sending to any other address (a real user registering with their own Gmail, for example)
# will fail with an error from Resend, not silently succeed. This is a Resend platform rule,
# not a bug in this code — verifying a domain is the only way to send to arbitrary recipients.
RESEND_API_KEY=your-resend-api-key

# Optional. Defaults to Resend's own pre-verified onboarding@resend.dev testing sender (see
# backend/src/lib/email.js) if unset — a real, Resend-authorized address, not invented. Set
# this once a real domain is verified in the Resend dashboard, e.g. verify@yourdomain.com.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Secret used to encrypt pending registration passwords before verification.
# Use a long, random value and keep it private.
PENDING_REGISTRATION_SECRET=your-32-byte-secret

# OpenWeatherMap -> API keys tab (https://home.openweathermap.org/api_keys).
# Powers the Demand Forecast dashboard's real weather data (backend/src/lib/weatherService.js).
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Gemini -> https://aistudio.google.com/apikey
# Powers the Demand Forecast dashboard's plain-language AI market analysis/recommendation
# (backend/src/lib/geminiService.js). The forecast price/demand numbers themselves never
# come from Gemini — they're always computed by priceForecastEngine.js/forecastEngine.js
# from real data — this key only unlocks the narrative explanation of an already-computed
# forecast. Without it, aiSummary/aiRecommendation are simply null (the rest of the
# dashboard still works).
GEMINI_API_KEY=your-gemini-api-key
